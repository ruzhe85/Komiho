CREATE VIEW historyView AS
SELECT
    history._id AS id,
    mangas._id AS mangaId,
    chapters._id AS chapterId,
    mangas.title,
    mangas.thumbnail_url AS thumbnailUrl,
    mangas.source,
    mangas.favorite,
    mangas.cover_last_modified,
    chapters.chapter_number AS chapterNumber,
    history.last_read AS readAt,
    history.time_read AS readDuration,
    max_last_read.last_read AS maxReadAt,
    max_last_read.chapter_id AS maxReadAtChapterId
FROM mangas
JOIN chapters
ON mangas._id = chapters.manga_id
JOIN history
ON chapters._id = history.chapter_id
JOIN (
    SELECT chapters.manga_id,chapters._id AS chapter_id, MAX(history.last_read) AS last_read
    FROM chapters JOIN history
    ON chapters._id = history.chapter_id
    GROUP BY chapters.manga_id
) AS max_last_read
ON chapters.manga_id = max_last_read.manga_id;

history:
SELECT
id,
mangaId,
chapterId,
title,
thumbnailUrl,
source,
favorite,
cover_last_modified,
chapterNumber,
readAt,
readDuration
FROM historyView
WHERE historyView.readAt > 0
AND maxReadAtChapterId = historyView.chapterId
AND lower(historyView.title) LIKE ('%' || :query || '%')
ORDER BY readAt DESC;

getLatestHistory:
SELECT
id,
mangaId,
chapterId,
title,
thumbnailUrl,
source,
favorite,
cover_last_modified,
chapterNumber,
readAt,
readDuration
FROM historyView
WHERE historyView.readAt > 0
ORDER BY readAt DESC
LIMIT 1;

-- SY --> Komiho: 本地模式历史 tab —— 按来源（如 LocalSource.ID）过滤最近阅读。
-- 复用 mapHistoryWithRelations，列顺序/类型必须与 history 查询一致。
historyBySource:
SELECT
id,
mangaId,
chapterId,
title,
thumbnailUrl,
source,
favorite,
cover_last_modified,
chapterNumber,
readAt,
readDuration
FROM historyView
WHERE historyView.readAt > 0
AND maxReadAtChapterId = historyView.chapterId
AND historyView.source = :sourceId
ORDER BY readAt DESC;

-- 文件级历史：返回该来源下每一条历史记录（不按 manga 去重），
-- 包含章节名、章节 URL、last_page_read、date_upload 等用于列表展示。
historyBySourceDetailed:
SELECT
    history._id AS id,
    chapters.manga_id AS mangaId,
    chapters._id AS chapterId,
    mangas.title AS mangaTitle,
    mangas.thumbnail_url AS thumbnailUrl,
    chapters.name AS chapterName,
    chapters.chapter_number AS chapterNumber,
    chapters.last_page_read AS lastPageRead,
    chapters.url AS chapterUrl,
    chapters.date_upload AS dateUpload,
    history.last_read AS readAt,
    history.time_read AS readDuration
FROM history
JOIN chapters ON chapters._id = history.chapter_id
JOIN mangas ON mangas._id = chapters.manga_id
WHERE history.last_read > 0
AND mangas.source = :sourceId
ORDER BY history.last_read DESC;
